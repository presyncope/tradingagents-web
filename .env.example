# Copy to .env (or point TRADINGAGENTS_WEB_ENV_FILE at your TradingAgents .env).
# The server reads it once at start; keys never leave the server.

# --- LLM provider keys: set the ones you use -----------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
#XAI_API_KEY=
#DEEPSEEK_API_KEY=
#OPENROUTER_API_KEY=
#DASHSCOPE_API_KEY=
#ZHIPU_API_KEY=
#MINIMAX_API_KEY=
#MISTRAL_API_KEY=
#MOONSHOT_API_KEY=
#GROQ_API_KEY=
#NVIDIA_API_KEY=
#OPENAI_COMPATIBLE_API_KEY=
#OLLAMA_BASE_URL=http://your-ollama-host:11434/v1

# --- Data sources (optional) ---------------------------------------------------
#SEC_EDGAR_USER_AGENT=Your Name your@email.com
#FRED_API_KEY=
#ALPHA_VANTAGE_API_KEY=
#TYPESAFE_API_KEY=

# --- TradingAgents defaults (the web settings page overrides these) ------------
# The full list is in TradingAgents' .env.example.
#TRADINGAGENTS_LLM_PROVIDER=openai
#TRADINGAGENTS_DEEP_THINK_LLM=gpt-6-sol
#TRADINGAGENTS_QUICK_THINK_LLM=gpt-6-luna
#TRADINGAGENTS_OUTPUT_LANGUAGE=Korean
#TRADINGAGENTS_RESULTS_DIR=
#TRADINGAGENTS_CACHE_DIR=
#TRADINGAGENTS_MEMORY_LOG_PATH=

# --- Web server ------------------------------------------------------------------
# Required to listen on anything but 127.0.0.1. Long and random: openssl rand -hex 32
#TRADINGAGENTS_WEB_TOKEN=
# Runs at once (each is a process calling your LLM provider).
#TRADINGAGENTS_WEB_MAX_WORKERS=2
# A backtest with more ticker x date cells than this is refused.
#TRADINGAGENTS_WEB_MAX_BACKTEST_CELLS=200
# Default: ~/.tradingagents/webapp.db
#TRADINGAGENTS_WEB_DB=
# Time zone for schedules and the times pages show (IANA name). Default: the system's.
#TRADINGAGENTS_WEB_TZ=Asia/Seoul
# Host names served while no token is set (DNS-rebinding guard).
#TRADINGAGENTS_WEB_ALLOWED_HOSTS=127.0.0.1,localhost
